.venv/
__pycache__/
*.pyc
.env
.env.*
!.env.example
*.egg-info/
build/
# Python build output at the repo root only — anchored so it does NOT match the
# source package src/fibreops/dist/ (the M365 Copilot package builder). The
# `publish-m365` command's default output dir (dist/m365) stays ignored.
/dist/
.pytest_cache/
.coverage
.azure/

# state/ holds ephemeral runtime data, including environment-specific published
# agent versions. Never commit the registry or bake it into an image.
state/*

# Stray local logs (azd, acr build streams, etc.) — never commit
*.log
azd-*.log
.venv-voice/
.venv-evaluation/
