{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "namePrefix":              { "value": "${FIBREOPS_NAME_PREFIX=fbreops}" },
    "location":                { "value": "${AZURE_LOCATION=swedencentral}" },
    "foundryAccountName":      { "value": "${AZURE_FOUNDRY_ACCOUNT_NAME=}" },
    "foundryProjectName":      { "value": "${AZURE_FOUNDRY_PROJECT_NAME=}" },
    "foundryProjectDisplayName": { "value": "${AZURE_FOUNDRY_PROJECT_DISPLAY_NAME=FibreOps agents}" },
    "containerImageName":      { "value": "${SERVICE_FIBREOPS_NOC_IMAGE_NAME=mcr.microsoft.com/k8se/quickstart:latest}" },
    "hardenRegistry":          { "value": "${FIBREOPS_HARDEN_REGISTRY=false}" },
    "azureAiProjectEndpoint":  { "value": "${AZURE_AI_PROJECT_ENDPOINT=}" },
    "azureAiModelDeployment":  { "value": "${AZURE_AI_MODEL_DEPLOYMENT=gpt-5.4-mini}" },
    "azureAiModelName":        { "value": "${AZURE_AI_MODEL_NAME=gpt-5.4-mini}" },
    "azureAiModelVersion":     { "value": "${AZURE_AI_MODEL_VERSION=2026-03-17}" },
    "azureAiModelSku":         { "value": "${AZURE_AI_MODEL_SKU=GlobalStandard}" },
    "azureAiModelCapacity":    { "value": "${AZURE_AI_MODEL_CAPACITY=200}" },
    "azureVoiceAgentName":     { "value": "${AZURE_VOICE_AGENT_NAME=}" },
    "provisionVoiceProject":   { "value": "${PROVISION_VOICE_PROJECT=true}" },
    "voiceProjectName":        { "value": "${AZURE_VOICE_PROJECT_NAME=}" },
    "voiceProjectDisplayName": { "value": "${AZURE_VOICE_PROJECT_DISPLAY_NAME=FibreOps voice agents}" },
    "azureVoiceProjectEndpoint": { "value": "${AZURE_VOICE_PROJECT_ENDPOINT=}" },
    "azureVoiceAgentModel":    { "value": "${AZURE_VOICE_AGENT_MODEL=gpt-realtime-2.1}" },
    "azureVoiceAgentModelType": { "value": "${AZURE_VOICE_AGENT_MODEL_TYPE=self_deployed}" },
    "azureVoiceAgentModelVersion": { "value": "${AZURE_VOICE_AGENT_MODEL_VERSION=2026-07-07}" },
    "azureVoiceAgentModelSku": { "value": "${AZURE_VOICE_AGENT_MODEL_SKU=GlobalStandard}" },
    "azureVoiceAgentModelCapacity": { "value": "${AZURE_VOICE_AGENT_MODEL_CAPACITY=1}" },
    "azureVoiceAgentVersion":  { "value": "${AZURE_VOICE_AGENT_VERSION=}" },
    "azureVoiceAgentVoice": { "value": "${AZURE_VOICE_AGENT_VOICE=ar-AE-Rashid:DragonHDLatestNeural}" },
    "azureVoiceAgentVoiceType": { "value": "${AZURE_VOICE_AGENT_VOICE_TYPE=azure-standard}" },
    "azureVoiceAgentPreferLocales": { "value": "${AZURE_VOICE_AGENT_PREFER_LOCALES=en-GB,ar-AE}" },
    "entraClientId":           { "value": "${FIBREOPS_AAD_CLIENT_ID}" },
    "entraClientSecret":       { "value": "${FIBREOPS_AAD_CLIENT_SECRET}" },
    "entraAllowedUserObjectId":{ "value": "${FIBREOPS_ALLOWED_USER_OBJECT_ID}" },
    "fibreopsAgentBackend":    { "value": "${FIBREOPS_AGENT_BACKEND=hosted}" },
    "fibreopsHostedAgentName": { "value": "${FIBREOPS_HOSTED_AGENT_NAME=fibreops-outage-response}" },
    "azureVoiceLiveEndpoint":  { "value": "${AZURE_VOICE_LIVE_ENDPOINT=}" },
    "azureVoiceLiveApiKey":    { "value": "${AZURE_VOICE_LIVE_API_KEY=}" },
    "provisionVoiceLive":      { "value": "${PROVISION_VOICE_LIVE=true}" },
    "voiceLiveLocation":       { "value": "${AZURE_VOICE_LIVE_LOCATION=}" },
    "voiceLiveSku":            { "value": "${AZURE_VOICE_LIVE_SKU=S0}" },
    "searchLocation":         { "value": "${AZURE_SEARCH_LOCATION=}" }
  }
}
