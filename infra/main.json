        "[resourceId('Microsoft.CognitiveServices/accounts/projects', variables('voiceLiveAccountName'), variables('resolvedVoiceProjectName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2024-11-01",
      "name": "[variables('kvName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "family": "A",
          "name": "standard"
