    "ehName": "fibre-signals",
    "lawName": "[format('{0}-law-{1}', parameters('namePrefix'), variables('suffix'))]",
    "kvName": "[toLower(format('{0}kv{1}', parameters('namePrefix'), substring(variables('suffix'), 0, 6)))]",
    "appiName": "[format('{0}-appi-{1}', parameters('namePrefix'), variables('suffix'))]",
    "acrName": "[toLower(format('{0}acr{1}', parameters('namePrefix'), substring(variables('suffix'), 0, 8)))]",
    "planName": "[format('{0}-plan-{1}', parameters('namePrefix'), variables('suffix'))]",
    "webName": "[toLower(format('{0}-noc-{1}', parameters('namePrefix'), substring(variables('suffix'), 0, 6)))]",
    "searchName": "[toLower(format('{0}-search-{1}', parameters('namePrefix'), substring(variables('suffix'), 0, 8)))]",
    "voiceLiveAccountName": "[toLower(format('{0}-aisvc-{1}', parameters('namePrefix'), substring(variables('suffix'), 0, 6)))]",
    "resolvedVoiceProjectName": "[if(empty(parameters('voiceProjectName')), format('{0}-voice-agents', parameters('namePrefix')), parameters('voiceProjectName'))]",
    "resolvedFoundryAccountName": "[if(empty(parameters('foundryAccountName')), toLower(format('{0}-foundry-{1}', parameters('namePrefix'), substring(variables('suffix'), 0, 6))), parameters('foundryAccountName'))]",
    "resolvedFoundryProjectName": "[if(empty(parameters('foundryProjectName')), format('{0}-agents', parameters('namePrefix')), parameters('foundryProjectName'))]",
    "voiceLiveRegion": "[if(empty(parameters('voiceLiveLocation')), parameters('location'), parameters('voiceLiveLocation'))]",
    "resolvedProjectEndpoint": "[if(empty(parameters('azureAiProjectEndpoint')), format('https://{0}.services.ai.azure.com/api/projects/{1}', variables('resolvedFoundryAccountName'), variables('resolvedFoundryProjectName')), parameters('azureAiProjectEndpoint'))]",
    "resolvedVoiceProjectEndpoint": "[if(not(empty(parameters('azureVoiceProjectEndpoint'))), parameters('azureVoiceProjectEndpoint'), if(and(parameters('provisionVoiceLive'), parameters('provisionVoiceProject')), format('https://{0}.services.ai.azure.com/api/projects/{1}', variables('voiceLiveAccountName'), variables('resolvedVoiceProjectName')), variables('resolvedProjectEndpoint')))]",
    "voiceLiveSecretName": "AZURE-VOICE-LIVE-API-KEY",
    "hasVoiceLiveKey": "[or(parameters('provisionVoiceLive'), not(empty(parameters('azureVoiceLiveApiKey'))))]",
    "resolvedSearchEndpoint": "[if(parameters('provisionFoundryIq'), format('https://{0}.search.windows.net', variables('searchName')), '')]"
